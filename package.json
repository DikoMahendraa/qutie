{
  "name": "qutie",
  "productName": "Qutie",
  "version": "1.0.0",
  "description": "Quick Translate. Translate any selected text in any app with a global shortcut.",
  "author": "Qutie contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/DikoMahendraa/qutie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DikoMahendraa/qutie.git"
  },
  "bugs": {
    "url": "https://github.com/DikoMahendraa/qutie/issues"
  },
  "keywords": [
    "translate",
    "translator",
    "electron",
    "react",
    "typescript",
    "desktop-app",
    "productivity",
    "cross-platform"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
